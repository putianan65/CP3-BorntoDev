menuList = []
priceList = []

def showBill():
    print("====My Food====")
    for number in range(len(menuList)):
        print(menuList[number], priceList[number])

def showTotal():
    print("----Total----")
    totalSum = sum(priceList)
    print(f"Total: {totalSum} บาท")

while True:
    menuName = input("Please enter a menu option: ")
    if (menuName.lower() == "exit"):
        break
    else:
        menuPrice = int(input("Please enter a Price: "))
        menuList.append(menuName)
        priceList.append(menuPrice)

showBill()
showTotal()
